# Contact form (src/app/api/contact/route.ts) - Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Analytics (optional - each tag renders only when its ID is set)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_AHREFS_KEY=
NEXT_PUBLIC_META_PIXEL_ID=

# IndexNow submissions (scripts/indexnow.mjs). Serve the same key at /<key>.txt in public/.
INDEXNOW_KEY=

# Live reviews (src/lib/fetchReviews.ts). Page to scrape for client reviews;
# leave empty to always use the snapshot in src/lib/reviews.ts.
REVIEWS_SOURCE_URL=
